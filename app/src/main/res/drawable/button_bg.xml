<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#FF6B4417" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape><solid android:color="#FFBFA98A" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/accent" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
